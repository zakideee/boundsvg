exports[`conformance SVG snapshots > native-glyph-selection renders a stable normalized SVG 1`] = `
"<svg data-boundsvg-node-id="ngs-canvas" height="315" viewBox="0 0 560 315" width="560" xmlns="http://www.w3.org/2000/svg">
  <rect fill="#ffffff" height="315" width="560" x="0" y="0" />
  <g data-boundsvg-node-id="ngs-root">

exports[`conformance SVG snapshots > native-step-easing renders a stable normalized SVG 1`] = `
"<svg data-boundsvg-node-id="nse-canvas" height="220" viewBox="0 0 420 220" width="420" xmlns="http://www.w3.org/2000/svg">
  <style>
    @keyframes anim-nse-keyword-keyframes {
      0% { opacity: 0.2; }
      50% { opacity: 1; }
      100% { opacity: 0.2; }
    }
    .bsvg-anim-nse-keyword {
      animation-name: anim-nse-keyword-keyframes;
      animation-duration: 1000ms;
      animation-delay: 0ms;
      animation-timing-function: step-start;
      animation-iteration-count: 1;
      animation-fill-mode: both;
    }
    @keyframes anim-nse-object-keyframes {
      0% { opacity: 0.15; }
      100% { opacity: 1; }
    }
    .bsvg-anim-nse-object {
      animation-name: anim-nse-object-keyframes;
      animation-duration: 1000ms;
      animation-delay: 0ms;
      animation-timing-function: steps(4, jump-both);
      animation-iteration-count: 1;
      animation-fill-mode: both;
    }
  </style>
  <rect fill="#f8fafc" height="220" width="420" x="0" y="0" />
  <g data-boundsvg-node-id="nse-stage">
    <g data-boundsvg-node-id="nse-row">
      <g class="bsvg-anim-nse-keyword" data-boundsvg-node-id="nse-keyword">
        <rect fill="#2563eb" height="72" rx="16" ry="16" width="72" x="118" y="54" />
      </g>
      <g class="bsvg-anim-nse-object" data-boundsvg-node-id="nse-object" opacity="0.32">
        <rect fill="#e11d48" height="72" rx="36" ry="36" width="72" x="230" y="54" />
      </g>

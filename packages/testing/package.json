{
  "name": "@boundsvg/testing",
  "version": "0.2.0",
  "description": "Testing helpers for boundsvg snapshots and render diagnostics",
  "keywords": [
    "svg",
    "testing",
    "snapshot",
    "vitest"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakideee/boundsvg.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/zakideee/boundsvg/tree/main/packages/testing",
  "bugs": {
    "url": "https://github.com/zakideee/boundsvg/issues"
  },
  "author": "zakideee",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js",
      "require": "./dist/vitest.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "@boundsvg/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}

[
  {
    "id": "ruby-horizontal-mono-over",
    "category": "ruby",
    "description": "横組 1 文字 base / rubyPosition=over の基本配置",
    "request": {
      "text": "",
      "rich_text": [
        { "kind": "text", "text": "東" },
        {
          "kind": "ruby",
          "rubyPosition": "over",
          "rubyAlign": "center",
          "style": { "fontFamily": ["NotoSansJP"], "fontSizePx": 24 },
          "base": [{ "kind": "text", "text": "京" }],
          "rt": [
            {
              "kind": "span",
              "text": "きょう",
              "style": { "fontFamily": ["NotoSansJP"], "fontSizePx": 12 }
            }
          ]
        },
        { "kind": "text", "text": "都" }
      ],
      "font_family": "NotoSansJP",
      "font_size_px": 24,
      "max_width": 240,
      "max_height": 160,
      "wrap": "Word",
      "fit": "None",
      "language": "Ja",
      "writing_mode": "HorizontalTb",
      "line_height": 1.5,
      "letter_spacing_px": 0,
      "hanging_punctuation": false
    },
    "expected": {
      "overflow": "none",
      "line_count": 1,
      "glyph_assertions": [
        { "text": "京", "font_size_px": 24 },
        { "text": "き", "font_size_px": 12, "relative_to": "京", "position": "above" },
        { "text": "ょ", "font_size_px": 12, "relative_to": "京", "position": "above" },
        { "text": "都", "font_size_px": 24 }
      ],
      "atomic_text_groups": [["京", "き", "ょ", "う"]]
    }
  },
